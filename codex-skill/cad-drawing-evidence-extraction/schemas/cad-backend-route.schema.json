{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xuyaoyang/cad-drawing-evidence-toolkit/schemas/cad-backend-route.schema.json",
  "title": "CAD read-only backend route record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_order",
    "status",
    "selected_backend",
    "selected_output",
    "source_name",
    "source_dwg_version",
    "source_sha256_before",
    "source_sha256_after",
    "source_unchanged",
    "portable_fallback_reasons",
    "absence_proven",
    "attempts"
  ],
  "properties": {
    "schema_version": {"const": "cad-backend-route/0.2"},
    "route_order": {
      "const": [
        "ACadSharp",
        "ZWCAD",
        "AutoCAD2023",
        "AutoCAD2020",
        "AutoCAD2018",
        "AutoCAD2014"
      ]
    },
    "status": {
      "enum": [
        "portable_candidate_selected",
        "zwcad_native_fallback_selected",
        "autocad_2023_native_fallback_selected",
        "autocad_2020_native_fallback_selected",
        "autocad_2018_native_fallback_selected",
        "autocad_2014_native_fallback_selected",
        "manual_review_required_no_backend",
        "source_hash_changed_safe_stop"
      ]
    },
    "selected_backend": {
      "type": ["string", "null"],
      "enum": [
        "ACadSharp",
        "ZWCAD",
        "AutoCAD2023",
        "AutoCAD2020",
        "AutoCAD2018",
        "AutoCAD2014",
        null
      ]
    },
    "selected_output": {"type": ["string", "null"]},
    "source_name": {"type": "string", "minLength": 1},
    "source_dwg_version": {
      "type": "string",
      "pattern": "^(AC[0-9]{4}|UNRECOGNIZED)$"
    },
    "source_sha256_before": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_sha256_after": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_unchanged": {"type": "boolean"},
    "portable_fallback_reasons": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "absence_proven": {"const": false},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "backend",
          "status",
          "message",
          "output",
          "reasons",
          "host_release",
          "host_api_version",
          "host_file_version",
          "max_dwg_version"
        ],
        "properties": {
          "backend": {
            "enum": [
              "ACadSharp",
              "ZWCAD",
              "AutoCAD2023",
              "AutoCAD2020",
              "AutoCAD2018",
              "AutoCAD2014"
            ]
          },
          "status": {
            "enum": [
              "success",
              "fallback_required",
              "failed",
              "not_available",
              "incompatible"
            ]
          },
          "message": {"type": ["string", "null"]},
          "output": {"type": ["string", "null"]},
          "reasons": {
            "type": "array",
            "items": {"type": "string"}
          },
          "host_release": {
            "type": ["string", "null"],
            "enum": ["2023", "2020", "2018", "2014", null]
          },
          "host_api_version": {
            "type": ["string", "null"],
            "pattern": "^R[0-9]+\\.[0-9]+$"
          },
          "host_file_version": {"type": ["string", "null"]},
          "max_dwg_version": {
            "type": ["string", "null"],
            "pattern": "^AC[0-9]{4}$"
          }
        }
      }
    }
  }
}
